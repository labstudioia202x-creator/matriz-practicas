# ----------------------------------------------------------------------------
# Copia este archivo como ".env.local" y completa los valores.
# Los encuentras en: Supabase Dashboard > Project Settings > API
#
# IMPORTANTE (2026): Supabase usa claves nuevas. Mapeo con las anteriores:
#   - Publishable key (sb_publishable_...) = antigua "anon"
#   - Secret key (sb_secret_...)           = antigua "service_role"
# Tanto las claves antiguas como las nuevas funcionan con supabase-js.
# ----------------------------------------------------------------------------

# URL del proyecto (ej: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (antigua anon) - ES SEGURA para exponer en el navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (antigua service_role) - ES SECRETA: solo para scripts de
# servidor, NUNCA para el navegador. Solo la necesita "npm run setup-admin".
SUPABASE_SERVICE_ROLE_KEY=