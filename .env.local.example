# ----------------------------------------------------------------------------
# Copia este archivo como ".env.local" y completa los valores.
# Los encuentras en: Supabase Dashboard > Project Settings > API
#
# IMPORTANTE (2026): Supabase usa claves nuevas. Mapeo con las anteriores:
#   - Publishable key (sb_publishable_...) = antigua "anon"
#   - Secret key (sb_secret_...)           = antigua "service_role"
# Tanto las claves antiguas como las nuevas funcionan con supabase-js.
# ----------------------------------------------------------------------------

# URL del proyecto (ej: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (antigua anon) - ES SEGURA para exponer en el navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (antigua service_role) - ES SECRETA: solo para scripts de
# servidor, NUNCA para el navegador. Solo la necesita "npm run setup-admin".
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# MICROSOFT 365 (SharePoint / OneDrive) - subida de soportes
# Se crean en: portal.azure.com > Microsoft Entra ID > Registros de aplicaciones
#   1. "Nuevo registro". Cuentas: solo de este directorio organizativo.
#   2. URI de redireccionamiento tipo "Web":
#        http://localhost:3000/api/microsoft/callback     (desarrollo)
#        https://TU-DOMINIO.vercel.app/api/microsoft/callback  (produccion)
#      Deben registrarse AMBAS.
#   3. Certificados y secretos > Nuevo secreto de cliente > copiar el "Valor".
#   4. Permisos de API > Microsoft Graph > Permisos DELEGADOS:
#        offline_access, Files.ReadWrite.All, User.Read
#      Si el tenant exige aprobacion, TI debe dar "Conceder consentimiento
#      del administrador" una sola vez.
# ----------------------------------------------------------------------------

# Id. de aplicacion (cliente)
MICROSOFT_CLIENT_ID=

# Valor del secreto de cliente (SECRETO, nunca en el navegador)
MICROSOFT_CLIENT_SECRET=

# Id. de directorio (inquilino) de UCompensar
MICROSOFT_TENANT_ID=
